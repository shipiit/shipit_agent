{
  "manifest_version": 3,
  "name": "Shipit · Workspace companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "A private-by-default Shipit sidebar. Ask about a page, understand a document, and draft your next step.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8400/*"],
  "action": {"default_title": "Open Shipit"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8400"}
}
