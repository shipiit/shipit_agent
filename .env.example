# Copy this file to .env before running examples/run_multi_tool_agent.py.

# Core agent settings
SHIPIT_LLM_PROVIDER=bedrock
SHIPIT_AGENT_PROMPT=You are a decisive engineering agent. Use tools when they improve accuracy, verify important claims, and keep answers concise.
SHIPIT_PROMPT=Research the project, use the available tools, and summarize what matters.
SHIPIT_STREAM=0
SHIPIT_SESSION_ID=demo-session
SHIPIT_TRACE_ID=demo-trace
SHIPIT_WORKSPACE_ROOT=.shipit_workspace

# Web search provider settings
# Default is duckduckgo to keep the out-of-box path dependency-light.
# Set SHIPIT_WEB_SEARCH_PROVIDER=playwright only if you also install the
# Playwright extra and browser binaries with: playwright install
SHIPIT_WEB_SEARCH_PROVIDER=duckduckgo
SHIPIT_WEB_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# AWS Bedrock via LiteLLM
SHIPIT_BEDROCK_MODEL=bedrock/openai.gpt-oss-120b-1:0
AWS_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# OpenAI
OPENAI_API_KEY=
SHIPIT_OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
SHIPIT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
SHIPIT_GEMINI_MODEL=gemini/gemini-1.5-pro

# Vertex AI via LiteLLM
SHIPIT_VERTEX_MODEL=vertex_ai/gemini-1.5-pro
SHIPIT_VERTEX_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEXAI_PROJECT=
GOOGLE_CLOUD_PROJECT=
VERTEXAI_LOCATION=us-central1
VERTEX_LOCATION=
GOOGLE_CLOUD_LOCATION=

# Generic LiteLLM / LiteLLM proxy
SHIPIT_LITELLM_MODEL=
SHIPIT_LITELLM_API_BASE=http://localhost:4000
SHIPIT_LITELLM_API_KEY=
SHIPIT_LITELLM_CUSTOM_PROVIDER=

# Groq
GROQ_API_KEY=
SHIPIT_GROQ_MODEL=groq/llama-3.3-70b-versatile

# Together
TOGETHERAI_API_KEY=
TOGETHER_API_KEY=
SHIPIT_TOGETHER_MODEL=together_ai/meta-llama/Llama-3.1-70B-Instruct-Turbo

# Ollama
OLLAMA_API_BASE=http://localhost:11434
SHIPIT_OLLAMA_MODEL=ollama/llama3.1

# ── Observability: shipit-watcher → Langfuse ─────────────────────────────
# Traces, the agent graph, scores, datasets and prompts all use these three.
# There is ONE url: the OTLP endpoint is derived as
# $LANGFUSE_HOST/api/public/otel/v1/traces — do not set an OTEL variable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your server. Self-hosted or an ngrok tunnel both work.
LANGFUSE_HOST=https://cloud.langfuse.com

# otlp carries semantic observation types (agent / tool / retriever), which
# is what makes Langfuse draw the agent GRAPH. It needs a v3 server; on a
# self-hosted v2 instance use sdk instead.
WATCHER_LANGFUSE_TRANSPORT=otlp

# Tags every trace, so several apps can share one Langfuse project and
# still be told apart.
WATCHER_SERVICE=shipit-agent
WATCHER_ENV=development

# Default dataset for capture(), so a call at the point of failure does not
# have to repeat the name.
WATCHER_DATASET=

# PII is redacted before anything leaves the process. Turning this off is a
# deliberate, auditable act.
WATCHER_MASK_PII=1
# Whether prompt/response BODIES are sent at all. 0 gives metrics-only
# traces, which some regulated deployments require.
WATCHER_CAPTURE_CONTENT=1

# audit records everything and blocks nothing. warn flags unregistered
# prompts. enforce REFUSES them — an outage wearing a config value.
WATCHER_GOVERNANCE=audit

# The local ledger: generations kept in your own database, so retention
# outlives a hosted plan. Off unless the host app provides the models.
WATCHER_PERSIST_DB=0
WATCHER_LEDGER_MODEL=agent.LLMCallRecord
WATCHER_LEDGER_EVENT_MODEL=agent.TraceEventRecord
